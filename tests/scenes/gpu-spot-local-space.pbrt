LookAt 0 0 5 0 0 0 0 1 0
Camera "perspective" "float fov" 50
Film "rgb" "integer xresolution" 32 "integer yresolution" 32
Sampler "halton" "integer pixelsamples" 64
Integrator "path" "integer maxdepth" 1
WorldBegin
AttributeBegin
Rotate 20 0 1 0
Scale 1.3 0.7 1.1
LightSource "spot" "point3 from" [1 0 3] "point3 to" [0 0 0] "blackbody I" 5000 "float scale" 20 "float coneangle" 35 "float conedeltaangle" 10
AttributeEnd
Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
Shape "trianglemesh" "point3 P" [-4 -4 0 4 -4 0 4 4 0 -4 4 0] "integer indices" [0 1 2 0 2 3]
