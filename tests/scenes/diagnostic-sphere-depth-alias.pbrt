Integrator "depth"
    "string mode" "t_hit"
    "string filename" "diagnostic-sphere-depth-alias.exr"
Sampler "independent" "integer pixelsamples" [ 1 ]
Film "rgb"
    "integer xresolution" [ 32 ]
    "integer yresolution" [ 32 ]
LookAt 0 0 4
    0 0 0
    0 1 0
Camera "perspective" "float fov" [ 30 ]
WorldBegin
Material "diffuse" "rgb reflectance" [ 0.7 0.2 0.2 ]
Shape "sphere" "float radius" [ 1 ]
