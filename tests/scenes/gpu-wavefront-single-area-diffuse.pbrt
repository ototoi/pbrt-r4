Integrator "volpath"
    "integer maxdepth" [ 2 ]
Sampler "independent"
    "integer pixelsamples" [ 16 ]
Film "rgb"
    "string filename" [ "gpu-wavefront-single-area-diffuse.exr" ]
    "integer xresolution" [ 128 ]
    "integer yresolution" [ 128 ]
LookAt 0 1.8 5.5
    0 1 0
    0 1 0
Camera "perspective"
    "float fov" [ 35 ]

WorldBegin

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 1 1 1 ]
    Shape "trianglemesh"
        "point3 P" [
            -3 0 -3   3 0 -3   3 0 3   -3 0 3
        ]
        "integer indices" [ 0 2 1  0 3 2 ]
AttributeEnd

AttributeBegin
    Translate 0 3 0.5
    AreaLightSource "diffuse"
        "rgb L" [ 30 30 30 ]
    Shape "trianglemesh"
        "point3 P" [
            -1 0 -1   1 0 -1   1 0 1   -1 0 1
        ]
        "integer indices" [ 0 1 2  0 2 3 ]
AttributeEnd
